{
  "name": "pr-review-agent",
  "version": "0.0.10",
  "description": "Automated PR code review agent powered by Claude",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node --input-type=module -e \"import{cpSync,mkdirSync}from'node:fs';mkdirSync('dist/prompt',{recursive:true});cpSync('src/prompt/base-prompt.txt','dist/prompt/base-prompt.txt');cpSync('src/prompt/reply-prompt.txt','dist/prompt/reply-prompt.txt');cpSync('src/prompt/judge-prompt.txt','dist/prompt/judge-prompt.txt');\"",
    "bundle": "node scripts/bundle.mjs",
    "version": "npm run bundle && git add dist/pr-review-agent.cjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "axios": "^1.20.0",
    "commander": "^12.1.0",
    "diff": "^9.0.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
