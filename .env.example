# VCS provider — 'bitbucket' (production); 'azure' and 'github' (experimental); 'gitlab' is not implemented (exits 1)
VCS_PROVIDER=bitbucket

# Bitbucket (Cloud only — Server/DC uses a different v1 REST API and is not supported)
BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
BITBUCKET_WORKSPACE=your-workspace-slug
BITBUCKET_USERNAME=your-atlassian-email@company.com
BITBUCKET_TOKEN=ATATT3x...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_WORKSPACE_ID=   # only if the key isn't workspace-scoped (user keys 400 without it)
CLAUDE_MODEL=claude-haiku-4-5-20251001
# LLM_PROVIDER=anthropic   # 'openrouter' routes via OpenRouter; CLAUDE_MODEL/JUDGING_MODEL then take slugs (e.g. openai/gpt-...)
# OPENROUTER_API_KEY=      # used when LLM_PROVIDER=openrouter; falls back to ANTHROPIC_API_KEY slot if unset
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=      # HTTP-Referer; defaults to the repo URL — needed for OpenRouter dashboard attribution
# OPENROUTER_TITLE=        # X-OpenRouter-Title; defaults to pr-review-agent
# MAX_RETRIES=3
# MAX_INPUT_TOKENS=250000
# MAX_OUTPUT_TOKENS=32000   # reviewer/judge output cap; thinking counts against it, so raise to ~64000 for xhigh/max effort
# REVIEW_EFFORT=           # low|medium|high|xhigh|max; empty = model default
# JUDGE_EFFORT=
# MODEL_CONTEXT_TOKENS=   # 0/unset = derive (200K for 4.5-gen, 1M for 4.6+/5.x; unmapped OpenRouter slugs from its model list, else 200K); set, replaces the reviewer window and fills in for unmapped models
# ENABLE_BUNDLED_REVIEW=false
# MAX_BUNDLES=8

# Agent identity — shown in review/reply footers
# Defaults to BITBUCKET_USERNAME if not set, then 'Claude'
# AGENT_IDENTITY=

# Judge model — validates findings before posting (default: claude-sonnet-5; empty = disable)
# JUDGING_MODEL=claude-sonnet-5
# REPLY_MODEL=             # model for dev-reply responses (empty = reviewer model); a cheaper one cuts reply cost
# ENABLE_JUDGE_KEEP_MINOR=false        # post `minor` findings as LOW instead of dropping them
# ENABLE_JUDGE_KEEP_UNVERIFIED=false   # post unverifiable / framework-uncertain findings (score capped at 5)
# ENABLE_JUDGE_KEEP_TEST_GAPS=false    # post low_value findings that name a test gap on a placeable line as LOW
# ENABLE_JUDGE_FILE_CONTEXT=false      # send the judge the reviewer's file contexts (~2x judge input tokens)
# ENABLE_JUDGE_PROPOSALS=false         # fix proposal per kept finding in results.jsonl anchored_findings
# ENABLE_SUGGESTED_FIXES=false         # post a "Suggested fix" code block under each kept finding that has one (implies code-only proposals; needs a judge)

# Reply limit — max agent reply comments per PR (0 = unlimited)
# MAX_REPLY_COMMENTS=5
# SKIP_DIRECTED_REPLIES=false   # skip dev comments @-directed at someone else (Bitbucket only)

# Context limits (optional — these are the defaults)
MAX_CONTEXT_FILES=20
MAX_FILE_LINES=500

# PR size thresholds (optional — 0 = disabled)
# MIN_CHANGED_FILES=0
# MAX_CHANGED_FILES=200
# MIN_CHANGED_LINES=0
# MAX_CHANGED_LINES=3000

# Branch exclusion — skip reviews for merge-back / release PRs
# SKIP_SOURCE_BRANCHES=main,master,release/*,hotfix/*
# SKIP_TARGET_BRANCHES=main,master
# ONLY_TARGET_BRANCHES=     # empty = off; review only PRs into these targets (main-only: SKIP_TARGET_BRANCHES= + ONLY_TARGET_BRANCHES=main + SKIP_SOURCE_BRANCHES=main,master)
# Per repo when the CI env is shared: --skip-target-branches= --only-target-branches=main --skip-source-branches=main,master (an empty flag value turns that list off)

# Trigger context — normally set by CI per run (per provider: docs/context/review/skip-logic.md §9)
# TRIGGER_EVENT=            # e.g. pullrequest:comment_created (Bitbucket X-Event-Key), issue_comment (GitHub event_name), ms.vss-code.git-pullrequest-comment-event (Azure service hook)
# TRIGGER_COMMENT_AUTHOR=   # event actor id (Bitbucket actor.uuid, GitHub sender.id, Azure comment author id), never the PR author
# TRIGGER_EVENT_KIND=       # 0.0.46+; comment|other: overrides whether the event counts as a comment event; per event, never job-wide on a job that also runs on pushes
# IGNORE_COMMENT_AUTHORS=   # actor ids whose comment events skip the run; only list one if CI queues (not drops) push events
# LAST_CHECKED_COMMIT=      # checked_commit an earlier run reported for this PR; CI passes it back (prefer this env var over --checked-commit)
# USAGE_RECORD_FILE=        # 0.0.46+; path that receives only this run's usage record (overwritten); delete it before the run

# Diff exclusion patterns (comma-separated, default includes lock files, .json, .spec.ts)
# DIFF_EXCLUDE_PATTERNS=*.lock,package-lock.json,yarn.lock,pnpm-lock.yaml,*.json,*.spec.ts

# Review tuning (optional)
# MAX_FINDINGS=0            # cap reported findings (0 = unlimited)
# ENABLE_SPLIT_CHECK=true   # add a "Can Be Split" section for multi-theme PRs (set false to disable)
# ENABLE_TODO_SCAN=true     # append TODO/FIXME/HACK markers found in added lines
# ENABLE_NITPICKS=false     # also surface real-but-minor findings; they post only with ENABLE_JUDGE_KEEP_MINOR
# ENABLE_LINE_NUMBERS=true  # number diff/context lines so findings cite lines (set false to send the raw diff)

# Azure DevOps (experimental / WIP) — used when VCS_PROVIDER=azure or --vcs azure
# AZURE_BASE_URL=https://dev.azure.com   # on-prem Server: your collection URL
# AZURE_ORG=
# AZURE_PROJECT=
# Provide ONE credential:
# AZURE_ACCESS_TOKEN=      # OAuth Bearer (e.g. pipeline System.AccessToken) — zero-PAT, preferred
# AZURE_PAT=               # Personal Access Token (Code read + Threads read&write) — HTTP Basic

# GitHub (experimental — same-repo PRs) — used when VCS_PROVIDER=github or --vcs github
# Triggered via GitHub Actions (.github/workflows/pr-review.yml); fork PRs out of scope.
# GITHUB_BASE_URL=https://api.github.com   # GitHub Enterprise: https://<host>/api/v3
# GITHUB_OWNER=                            # org or user (can also use --workspace)
# GITHUB_TOKEN=                            # PR read/write; in Actions, the provided GITHUB_TOKEN

# Recall levers (all default false; each is a behavior change, label-driven in ReviewBench)
# ENABLE_BREADTH_REVIEW=false                # extra reviewer-sized pass over changed files with no finding yet (needs a judge)
# BREADTH_MODEL=                             # empty = judge model (and JUDGE_EFFORT)
# BREADTH_EFFORT=
# BREADTH_MIN_FILES=5
# BREADTH_MIN_UNTOUCHED=3
# ENABLE_SECOND_LOOK=false                   # extra reviewer-sized pass over files that already have a finding (needs a judge)
# ENABLE_JUDGE_QUALITY=false                 # judge: narrow low_value evidence check, same-file duplicate validation, guarded per-file expansion (one call)
# ENABLE_JUDGE_SHOWN_CONTEXT_ANCHORS=false   # accept anchors on unchanged lines the pass/judge was shown
# ENABLE_SECOND_LOOK_BREADTH_TARGETS=false   # second-look also re-reads breadth-flagged files
# ENABLE_BREADTH_PRIORITY_TARGETS=false      # prioritized, diverse breadth targets instead of first-40
# ENABLE_LENSES=false                        # concern-specific reviewer passes named in LENSES, one reviewer-sized call each (label: LENSES)
# LENSES=                                    # e.g. reliability+security; any of reliability, security, testing, performance, architecture (aliases rel, sec, test, perf, arch)
# LENS_MODEL=                                # model for lens passes (empty = reviewer model)
# ENABLE_LENS_RECOMMENDATION=false           # log-only: first-pass reviewer names the lenses worth running (results.jsonl lens_recommendations); never gates a lens (label: LENS_REC)
# ENABLE_BENCHMARK_COUNTERPART_ROWS=false    # --benchmark only: findings.json also gets each kept finding at the other changed files its reviewer text cites with a line; never posted (label: XROWS)
