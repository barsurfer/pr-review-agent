# VCS provider — 'bitbucket' (production); 'azure' and 'github' (experimental); 'gitlab' (stub)
VCS_PROVIDER=bitbucket

# Bitbucket (Cloud only — Server/DC uses a different v1 REST API and is not supported)
BITBUCKET_BASE_URL=https://api.bitbucket.org/2.0
BITBUCKET_WORKSPACE=your-workspace-slug
BITBUCKET_USERNAME=your-atlassian-email@company.com
BITBUCKET_TOKEN=ATATT3x...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_WORKSPACE_ID=   # only if the key isn't workspace-scoped (user keys 400 without it)
CLAUDE_MODEL=claude-haiku-4-5-20251001
# LLM_PROVIDER=anthropic   # 'openrouter' routes via OpenRouter; CLAUDE_MODEL/JUDGING_MODEL then take slugs (e.g. openai/gpt-...)
# OPENROUTER_API_KEY=      # required instead of ANTHROPIC_API_KEY when LLM_PROVIDER=openrouter
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=      # optional attribution header
# OPENROUTER_TITLE=        # optional attribution header
# MAX_RETRIES=3
# MAX_INPUT_TOKENS=250000
# MODEL_CONTEXT_TOKENS=   # 0/unset = derive from model (200K for 4.5-gen, 1M for 4.6+/5.x); set for non-Claude OpenRouter slugs (falls back to 200K)
# ENABLE_BUNDLED_REVIEW=false
# MAX_BUNDLES=8

# Agent identity — shown in review/reply footers
# Defaults to BITBUCKET_USERNAME if not set, then 'Claude'
# AGENT_IDENTITY=

# Judge model — validates findings before posting (default: claude-sonnet-5; empty = disable)
# JUDGING_MODEL=claude-sonnet-5

# Reply limit — max agent reply comments per PR (0 = unlimited)
# MAX_REPLY_COMMENTS=5

# Context limits (optional — these are the defaults)
MAX_CONTEXT_FILES=20
MAX_FILE_LINES=500

# PR size thresholds (optional — 0 = disabled)
# MIN_CHANGED_FILES=0
# MAX_CHANGED_FILES=200
# MIN_CHANGED_LINES=0
# MAX_CHANGED_LINES=3000

# Branch exclusion — skip reviews for merge-back / release PRs
# SKIP_SOURCE_BRANCHES=main,master,release/*,hotfix/*
# SKIP_TARGET_BRANCHES=main,master

# Diff exclusion patterns (comma-separated, default includes lock files, .json, .spec.ts)
# DIFF_EXCLUDE_PATTERNS=*.lock,package-lock.json,yarn.lock,pnpm-lock.yaml,*.json,*.spec.ts

# Review tuning (optional)
# MAX_FINDINGS=0            # cap reported findings (0 = unlimited)
# ENABLE_SPLIT_CHECK=true   # add a "Can Be Split" section for multi-theme PRs (set false to disable)
# ENABLE_TODO_SCAN=true     # append TODO/FIXME/HACK markers found in added lines

# Azure DevOps (experimental / WIP) — used when VCS_PROVIDER=azure or --vcs azure
# AZURE_BASE_URL=https://dev.azure.com   # on-prem Server: your collection URL
# AZURE_ORG=
# AZURE_PROJECT=
# Provide ONE credential:
# AZURE_ACCESS_TOKEN=      # OAuth Bearer (e.g. pipeline System.AccessToken) — zero-PAT, preferred
# AZURE_PAT=               # Personal Access Token (Code read + Threads read&write) — HTTP Basic

# GitHub (experimental — same-repo PRs) — used when VCS_PROVIDER=github or --vcs github
# Triggered via GitHub Actions (.github/workflows/pr-review.yml); fork PRs out of scope.
# GITHUB_BASE_URL=https://api.github.com   # GitHub Enterprise: https://<host>/api/v3
# GITHUB_OWNER=                            # org or user (can also use --workspace)
# GITHUB_TOKEN=                            # PR read/write; in Actions, the provided GITHUB_TOKEN
